DATABASE_URL=postgres://tablero:tablero@localhost:5432/tablero?sslmode=disable
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Al menos 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-bytes-o-mas
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Secure cookies funcionan en http://localhost en los navegadores; ponlo en false solo si usas otra IP/host sin HTTPS.
COOKIE_SECURE=true
